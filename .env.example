# URL koneksi PostgreSQL Neon.
# Ambil dari dashboard Neon -> Connect -> Connection string.
#
# Untuk serverless (Vercel) gunakan URL **pooled** (berakhiran `-pooler`),
# karena driver `pg` membuka koneksi baru untuk tiap request.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Untuk Neon SQL Editor / psql lokal boleh memakai URL direct (tanpa `-pooler`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Opsional. Jumlah koneksi maksimum pada pool.
# Produksi Vercel: 5 (sesuaikan dengan batas Neon pada paket Anda).
# Lokal: 10. Kosongkan untuk memakai nilai bawaan.
# DATABASE_POOL_MAX=5
